# 복사해서 사용: cp .env.example .env
# 실행: uvicorn api.main:app --host 127.0.0.1 --port 8001 --env-file .env

# ---------- 모델 ----------
# Hugging Face 모델 id 또는 로컬 경로
QWEN_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
# auto | bfloat16 | float16 | float32
QWEN_DTYPE=auto
# auto | cuda | cpu
QWEN_DEVICE_MAP=auto
# sdpa | flash_attention_2 (flash-attn 설치 필요) | eager
QWEN_ATTN=sdpa
# 이미지 픽셀 수 범위 (비워 두면 모델 기본값)
QWEN_MIN_PIXELS=
QWEN_MAX_PIXELS=

# 1이면 서버 시작 시 모델을 미리 불러옴
PRELOAD_MODEL=1

# CPU 스레드 수. 컨테이너(LXC)에서 PyTorch가 CPU 정보를 읽다 죽는 문제를 피하려면 반드시 설정 (nproc 값)
OMP_NUM_THREADS=2

# ---------- 생성 ----------
QWEN_MAX_NEW_TOKENS=2048
# 0이면 항상 같은 결과(greedy), 높을수록 다양하게
QWEN_TEMPERATURE=0.3
QWEN_TOP_P=0.8
QWEN_TOP_K=20
QWEN_REPETITION_PENALTY=1.05
# 프롬프트에 넣을 요소 목록 최대 길이(자)
MAX_LAYOUT_TEXT_CHARS=30000
# 다른 요청이 GPU를 쓰는 중일 때 기다리는 최대 시간(초), 넘으면 503
GENERATE_QUEUE_TIMEOUT=300
# 받는 이미지 최대 크기(바이트)
MAX_IMAGE_BYTES=31457280

# ---------- 서버 ----------
# 설정하면 X-API-Key 헤더가 일치해야 호출 가능 (0.0.0.0으로 열 때는 필수)
AI_API_KEY=
# 0이면 Swagger(/docs, /redoc, /openapi.json) 끔
ENABLE_DOCS=1
LOG_LEVEL=INFO

# ---------- Hugging Face ----------
# 모델 다운로드 위치 (용량 큰 디스크로 지정)
HF_HOME=/data/hf-cache
# 공개 모델이라 없어도 되지만, 있으면 다운로드 속도 제한이 완화됨
HF_TOKEN=
